# Anthropic credentials for the CrewAI agents
ANTHROPIC_API_KEY=sk-ant-...

# LLM used by every agent in the crew (CrewAI native Anthropic provider)
SUPPORT_LLM_MODEL=anthropic/claude-opus-5-5
SUPPORT_LLM_EFFORT=medium

# PostgreSQL shared by Django and the MCP server
DATABASE_URL=postgres://support:support@localhost:5432/support

# Refunds above this amount cannot be auto-approved by the agents
SUPPORT_REFUND_AUTO_LIMIT=200

# Optional: pre-agent escalation rate (0-1) to compare against on the dashboard
SUPPORT_BASELINE_ESCALATION_RATE=

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
